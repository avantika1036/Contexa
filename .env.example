POSTGRES_DB=contexa
POSTGRES_USER=contexa_user
POSTGRES_PASSWORD=replace_with_a_local_dev_password
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://contexa_user:replace_with_a_local_dev_password@localhost:5433/contexa

# Real-time multilingual speech-to-text via Deepgram Nova-3 Multi.
# Use language=multi to auto-detect languages and support code-switching.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
# Optional comma-separated language hints to bias detection (not restrict it), e.g. en,hi
DEEPGRAM_LANGUAGE_HINTS=en
# Comma-separated names/terms to boost (Nova-3 keyterm prompting), e.g. DEEPGRAM_KEYTERMS=Avanti Kapadia,Contexa
DEEPGRAM_KEYTERMS=
# English-only meetings: DEEPGRAM_LANGUAGE=en. Hinglish: keep multi and set DEEPGRAM_LANGUAGE_HINTS=en,hi. See docs/transcription.md.

# Structured meeting-memory extraction via Groq's OpenAI-compatible API.
# Create a key at https://console.groq.com/keys. Keep the key only in .env.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
MEMORY_MODEL=openai/gpt-oss-120b
# No Groq calls during live capture. Extract once after a meeting ends (set false for manual-only mode).
MEMORY_AUTO_EXTRACT_ON_END=true
# Legacy setting: no longer triggers per-segment live extraction.
MEMORY_AUTO_EXTRACT=false

# Backward-compatible aliases for existing local .env files from the earlier patch.
# If GROQ_API_KEY is set, it takes precedence over these aliases.
# XAI_API_KEY=
# XAI_BASE_URL=https://api.groq.com/openai/v1

# --- Session lifecycle (optional; defaults shown) ---
# Backend: an active session with no transcript activity for this long counts as abandoned.
# STALE_ACTIVE_MEETING_MINUTES=20
# Desktop: how long a stopped session stays open so the same meeting can resume in it.
# CONTEXA_SESSION_GRACE_SECONDS=300
# Backend: a persisted suspended meeting can be resumed after an app restart during this window.
# SUSPENDED_SESSION_RESUME_GRACE_SECONDS=300
# Desktop: seconds a detected meeting window may be missing before capture stops.
# CONTEXA_STOP_AFTER_MISSING_SECONDS=15
# Desktop: seconds of total silence (everyone, including you) before the meeting counts as over. 0 disables.
# CONTEXA_IDLE_END_SECONDS=180
# Desktop: how long the same still-open meeting page may not restart capture after an idle end.
# CONTEXA_IDLE_RESTART_BLOCK_SECONDS=600
# Desktop: shorter grace period for Zoom/Teams/Webex windows (browser meetings use CONTEXA_SESSION_GRACE_SECONDS).
# CONTEXA_NATIVE_SESSION_GRACE_SECONDS=60
